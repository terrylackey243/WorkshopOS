APP_PORT=3027
POSTGRES_DB=workshopos
POSTGRES_USER=workshopos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://workshopos:change-me@workshopos-postgres:5432/workshopos
REDIS_URL=redis://workshopos-redis:6379/0
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720
CADDY_NETWORK_NAME=web

# --- Billing / plan enforcement -----------------------------------------
# "self_hosted" (offline license keys) or "saas" (Stripe subscriptions).
# self_hosted is the correct default for a fresh self-hosted install --
# leave the Stripe fields below blank in that case.
DEPLOYMENT_MODE=self_hosted
# Base URL this deployment is publicly reachable at; used to build Stripe
# Checkout success/cancel URLs and the billing portal return URL.
# SaaS-only -- self-hosted installs can leave this at the default.
APP_PUBLIC_URL=http://localhost:3027

# --- SaaS-only (Stripe) --------------------------------------------------
# Leave both blank for a self-hosted install.
# Stripe secret key (test or live mode) -- from the Stripe dashboard.
STRIPE_SECRET_KEY=
# Get this by running `stripe listen --forward-to <APP_PUBLIC_URL>/api/billing/webhook`
# and pasting the whsec_... it prints, or from the webhook endpoint's
# settings in the Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# --- Self-hosted-only (license keys) -------------------------------------
# Leave blank for a SaaS install.
# Ed25519 public key (PEM) used to verify self-hosted license keys offline.
# Every self-hosted install verifies against the same published public key
# (safe to be non-secret) -- see backend/scripts/mint_license.py for how a
# matching private key mints a license, and backend/app/services/license.py
# for verification. Wrap the PEM in double quotes to preserve its newlines,
# e.g.:
#   LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
#   ...
#   -----END PUBLIC KEY-----"
LICENSE_PUBLIC_KEY=
